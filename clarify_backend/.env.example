# Copy this file to .env and fill in real values. .env is gitignored.

# PostgreSQL connection string. URL-encode special characters in the password.
DATABASE_URL="postgresql://user:password@localhost:5432/clarify?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="1d"

PORT=3000

# USDA FoodData Central (https://fdc.nal.usda.gov/api-key-signup) — free,
# used to calculate recipe calories/macros. Without this set, POST
# /recipes/:id/nutrition returns 503.
USDA_FDC_API_KEY="replace-with-your-usda-fdc-api-key"

# Recipe import falls back to headless Chromium (playwright-core) when a site
# blocks plain HTTP requests. Set to "off" to disable the fallback, e.g. on a
# host without Chromium installed (see Dockerfile).
SCRAPER_BROWSER="on"
