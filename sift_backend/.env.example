# Copy this file to .env and fill in real values. .env is gitignored.

# `allowPublicKeyRetrieval=true` is required against MySQL 8+, whose default
# caching_sha2_password auth plugin needs it to authenticate over a
# non-SSL connection (harmless/standard for local dev).
DATABASE_URL="mysql://user:password@localhost:3306/sift?allowPublicKeyRetrieval=true"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="1d"

PORT=3000

# USDA FoodData Central (https://fdc.nal.usda.gov/api-key-signup) — free,
# used to calculate recipe calories/macros. Without this set, POST
# /recipes/:id/nutrition returns 503.
USDA_FDC_API_KEY="replace-with-your-usda-fdc-api-key"
